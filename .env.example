DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=oftisoft
DATABASE_PASSWORD=oftisoft_secret
DATABASE_NAME=oftisoft
DATABASE_URL=
DATABASE_SSLMODE=

# JWT Configuration
JWT_ACCESS_SECRET=your-jwt-access-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Application Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://oftisoft.com
API_URL=https://api.oftisoft.com

# SSL/TLS Configuration for Cloudflare
# Set to 'true' if using Cloudflare Origin Certificates
SSL_CERT_PATH=/app/ssl/cert.pem
SSL_KEY_PATH=/app/ssl/key.pem
TRUST_PROXY=true
SECURE_COOKIES=true
# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# OAuth - GitHub (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Configuration (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Environment

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# AWS S3/R2 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_REGION=
AWS_USE_PATH_STYLE_ENDPOINT=